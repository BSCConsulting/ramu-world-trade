  "risk_tiers": {
    "A1": {
      "rating": "Insignificant Risk",
      "description": "Highest creditworthiness, transparent legal enforceability, zero currency transfer restrictions.",
      "max_credit_tenor_days": 180,
      "underwriting_stance": "Standard Open Cover",
      "political_risk": "Negligible",
      "transfer_risk": "Unrestricted"
    },
    "A2": {
      "rating": "Low Risk",
      "description": "Strong macroeconomic indicators, sound banking sector, very low default probability.",
      "max_credit_tenor_days": 180,
      "underwriting_stance": "Standard Open Cover",
      "political_risk": "Low",
      "transfer_risk": "Stable"
    },
    "B1": {
      "rating": "Moderately Low Risk",
      "description": "Stable economic environment, moderate legal delays in debt recovery, minor foreign exchange volatility.",
      "max_credit_tenor_days": 180,
      "underwriting_stance": "Standard Open Cover with normal DCL",
      "political_risk": "Moderate-Low",
      "transfer_risk": "Normal"
    },
    "B2": {
      "rating": "Moderate Risk",
      "description": "Emerging economy volatility, elevated inflation or currency swings, buyer credit assessment recommended.",
      "max_credit_tenor_days": 120,
      "underwriting_stance": "Cover available; Specific Buyer Limits (SBL) required above DCL",
      "political_risk": "Moderate",
      "transfer_risk": "Monitor"
    },
    "C1": {
      "rating": "Moderately High Risk",
      "description": "Vulnerable balance of payments, foreign exchange rationing, LC confirmation recommended.",
      "max_credit_tenor_days": 90,
      "underwriting_stance": "Restricted Cover; Prior approval for open terms; Irrevocable LC advised",
      "political_risk": "Substantial",
      "transfer_risk": "Delayed / Rationed"
    },
    "C2": {
      "rating": "High Risk",
      "description": "Acute geopolitical, macroeconomic, or severe payment default stress. Elevated commercial dispute frequency.",
      "max_credit_tenor_days": 60,
      "underwriting_stance": "Specific Approval Cover only; Pre-shipment review mandatory",
      "political_risk": "Severe",
      "transfer_risk": "Constrained"
    },
    "D": {
      "rating": "Restricted / Off-Cover",
      "description": "Sanctioned or war-torn territories, complete foreign exchange freeze, international banking disconnection.",
      "max_credit_tenor_days": 0,
      "underwriting_stance": "Off-Cover. Advance 100% payment or Confirmed Irrevocable LC only",
      "political_risk": "Extreme",
      "transfer_risk": "Blocked"
    }
  },
