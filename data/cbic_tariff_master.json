{
  "metadata": {
    "title": "CBIC Customs Tariff First Schedule & 5-Layer Landed Duty Master",
    "authority": "Central Board of Indirect Taxes and Customs (CBIC), Department of Revenue, Ministry of Finance",
    "statutory_act": "Customs Tariff Act, 1975 (Act No. 51 of 1975)",
    "portal_url": "https://www.cbic.gov.in",
    "updated_at": "2026-10-25"
  },
  "statutory_rules": {
    "assessable_value": {
      "name": "Assessable Value (CIF in INR)",
      "legal_basis": "Section 14 of Customs Act, 1962 & Customs Valuation Rules, 2007",
      "formula": "(FOB Value + Freight + Insurance) converted at notified CBIC Gazette Rate"
    },
    "bcd": {
      "name": "Basic Customs Duty (BCD)",
      "legal_basis": "Section 12 of Customs Act, 1962 read with First Schedule to Customs Tariff Act, 1975",
      "formula": "Assessable Value * BCD Rate %"
    },
    "aidc": {
      "name": "Agriculture Infrastructure and Development Cess (AIDC)",
      "legal_basis": "Section 124 of Finance Act, 2021",
      "formula": "Assessable Value * AIDC Rate %"
    },
    "sws": {
      "name": "Social Welfare Surcharge (SWS)",
      "legal_basis": "Clause 110 of Finance Act, 2018 (replaces Education Cess)",
      "formula": "10% of (BCD + AIDC)"
    },
    "igst": {
      "name": "Integrated Goods and Services Tax (IGST)",
      "legal_basis": "Section 3(7) of Customs Tariff Act, 1975 read with Section 5 of IGST Act, 2017",
      "formula": "(Assessable Value + BCD + AIDC + SWS) * IGST Rate %"
    }
  },
