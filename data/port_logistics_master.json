  "pcs_milestones": [
    {
      "step": 1,
      "code": "FORM13",
      "name": "PCS 1x Form-13 Gate-in Permit",
      "description": "Customs CHA lodges electronic gate-in request with verified Shipping Bill and container seal number.",
      "sla_hours": 0.5
    },
    {
      "step": 2,
      "code": "GATEIN",
      "name": "Terminal Gate-in & Optical OCR Check",
      "description": "Container moves past RFID gate reader, weight captured on Weighbridge, and verified gross mass (VGM) verified.",
      "sla_hours": 1.0
    },
    {
      "step": 3,
      "code": "YARD_STACK",
      "name": "CY Yard Stacking & BAPLIE Load Planning",
      "description": "Container positioned in terminal yard according to ship bay plan (BAPLIE EDI message).",
      "sla_hours": 4.0
    },
    {
      "step": 4,
      "code": "BERTH_LOAD",
      "name": "Vessel Berthing & Quay Crane Loading",
      "description": "Quay Crane hoists container onto cellular vessel hold. EDI COARRI message transmitted to line and customs.",
      "sla_hours": 2.0
    },
    {
      "step": 5,
      "code": "SAIL_EGM",
      "name": "Vessel Sail & Export General Manifest (EGM)",
      "description": "Vessel departs port. Shipping Line files EGM on ICEGATE triggering electronic RoDTEP/IGST refund generation.",
      "sla_hours": 12.0
    }
  ]
