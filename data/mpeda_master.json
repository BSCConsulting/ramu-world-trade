  "statutory_schemes": {
    "eu_catch_certificate_scheme": {
      "regulation": "Council Regulation (EC) No 1005/2008 on Illegal, Unreported and Unregulated (IUU) Fishing",
      "competent_authority": "Designated Assistant Directors of MPEDA / EIC Officials",
      "portal": "https://mpeda.gov.in/e-catch",
      "required_fields": [
        "Vessel Name & Registration Number issued by State Fisheries Department / MMD",
        "Fishing License Number & Validity Date",
        "Log sheet of Catch (Date, Fishing Grounds, Gear Type, GPS Coordinates)",
        "Landing Date & Authorized Coastal Landing Center (e.g., Cochin Port, Sassoon Dock, Veraval)",
        "Master of Vessel / Captain Signature & Declarations",
        "Estimated Live Weight (kg) vs Processed Product Weight (kg)"
      ],
      "exemptions": ["Freshwater fish", "Aquaculture products (farmed shrimp/tilapia) accompanied by aquaculture health certificate"]
    },
    "us_noaa_simp_scheme": {
      "regulation": "Magnuson-Stevens Fishery Conservation and Management Act / NOAA Seafood Import Monitoring Program",
      "covered_indian_species": ["Shrimp (farmed & wild)", "Crab", "Tuna", "Swordfish"],
      "mandatory_audit_trail": [
        "Small-scale harvest event date and location",
        "Unique Farm Registration Number (NaCSA / CAA) for aquaculture",
        "Vessel Flag State, Identification, Gear Type",
        "Chain of Custody tracking from farm/dock to processor, cold storage, and export container",
        "US Importer of Record SIMP permit number"
      ]
    },
    "us_ted_exemption_ds2031": {
      "regulation": "Section 609 of Public Law 101-162 (16 U.S.C. 1537) - Protection of Sea Turtles",
      "embargo_status": "Wild-caught trawl shrimp from India is subject to US import embargo due to lack of certified Turtle Excluder Devices (TEDs).",
      "exemption_mechanism": "Farmed / Aquaculture Shrimp (Vannamei & Black Tiger) is 100% EXEMPT under Box 7(B) of US State Department Form DS-2031, certifying harvested from aquaculture facilities.",
      "signing_authority": "MPEDA Designated Officer / Marine Exporter under perjury declarations"
    }
  }
}
