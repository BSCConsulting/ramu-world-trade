  "surcharge_glossary": {
    "BAF": "Bunker Adjustment Factor: Floating fuel cost adjustment pegged to Rotterdam/Singapore VLSFO (Very Low Sulphur Fuel Oil) prices.",
    "Cape Surcharge": "Cape of Good Hope Diversion Surcharge: Additional compensation levied by shipping lines for circumnavigating Africa due to Bab-el-Mandeb / Red Sea disruptions.",
    "PSS": "Peak Season Surcharge: Seasonal surge charge applied during pre-holiday trade rushes (typically August to November).",
    "THC": "Terminal Handling Charge: Stevedoring and container handling at origin port quay cranes and container yard.",
    "War Risk": "War Risk Surcharge: Insurance premium surcharge applied to vessels navigating designated high-risk regional maritime waters."
  }
